# Copy this file to .env.local and fill in your own keys. Never commit .env.local.

# Deepgram (live speech-to-text). https://console.deepgram.com → API Keys → Create a New API Key.
# The key must have the Member role (or higher) so the server can issue short-lived browser tokens.
DEEPGRAM_API_KEY=

# Anthropic (Claude decides when to ask and writes the question). https://console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=

# Optional: Claude model. Default claude-sonnet-5-5; claude-opus-5-5 can be compared with `npm run replay -- <fixture> --model claude-opus-5-5`.
CLAUDE_MODEL=claude-sonnet-5-5

# Optional alternative to ANTHROPIC_API_KEY: route the same Claude request through Vercel AI Gateway.
# If set, it is used instead of ANTHROPIC_API_KEY. (Requires a Vercel account with AI Gateway credits.)
AI_GATEWAY_API_KEY=
